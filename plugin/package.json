{
  "name": "dsh-canness",
  "version": "0.2.0",
  "description": "Ascend CANN operator development for DeepSeek Harness: spec → four-layer operator → test package → remote evaluation loop.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ascend",
    "cann",
    "ascendc",
    "operator",
    "agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hanerson/CANNESS.git",
    "directory": "plugin"
  },
  "homepage": "https://github.com/Hanerson/CANNESS#readme",
  "bugs": {
    "url": "https://github.com/Hanerson/CANNESS/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.0 <0.3.0"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "knowledge_base",
    "remote",
    "templates"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./knowledge": "./lib/knowledge.js",
    "./generator": "./lib/generator.js",
    "./eval": "./lib/eval.js",
    "./loop": "./lib/loop.js",
    "./remote-api": "./lib/remote-api.js",
    "./client": "./lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.3",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/ssh2": "^1.15.6",
    "esbuild": "^0.25.12",
    "react": "^18.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
